{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llm-parcours",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llm-parcours",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
